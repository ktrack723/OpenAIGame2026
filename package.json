{
  "name": "bishoujo-rizz-simulator-2077",
  "version": "1.0.0",
  "description": "LLM 기반 연애 코칭 게임 — three.js · GitHub Pages",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.js 4173",
    "test": "node --test test/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run selfplay && npm run test:e2e",
    "live": "node tools/live-check.mjs",
    "live:browser": "playwright test --config=playwright.live.config.js",
    "selfplay": "node tools/selfplay.js",
    "balance": "node tools/selfplay.js --runs=60",
    "check": "find . \\( -name node_modules -o -name vendor -o -name .git \\) -prune -o \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check"
  },
  "engines": {
    "node": ">=20"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
